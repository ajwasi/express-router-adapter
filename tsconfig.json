{
    "compilerOptions": {
        "baseUrl": ".",
        "rootDir": "src",
        "outDir": "./dist/",
        "target": "es2020",
        "moduleResolution": "node",
        "module": "commonjs",
        "noImplicitAny": false,
        "lib": ["es2020"],
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["src"],
    "exclude": ["tests", "sample-app"]
}
