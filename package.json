{
  "name": "@ajwasi/express-router-adapter",
  "version": "2.0.0",
  "description": "ExpressRouterAdapter is a library that makes it easy to build evolvable hypermedia APIs using the express framework",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajwasi/express-router-adapter.git"
  },
  "homepage": "https://github.com/ajwasi/express-router-adapter#readme",
  "scripts": {
    "test": "TS_NODE_PROJECT=tsconfig.test.json mocha -r ts-node/register \"tests/**/*.test.ts\"",
    "test:watch": "TS_NODE_PROJECT=tsconfig.test.json mocha -r ts-node/register --watch --watch-extensions ts \"tests/**/*.test.ts\"",
    "test:coverage": "TS_NODE_PROJECT=tsconfig.test.json c8 --reporter=html --reporter=text-summary mocha -r ts-node/register \"tests/**/*.test.ts\"",
    "build": "rm -rf dist && npm run lint && mkdir -p dist && tsc -d -p tsconfig.json",
    "build:watch": "rm -rf dist && mkdir -p dist && tsc --watch -p tsconfig.json",
    "docs:build": "rm -rf docs && typedoc --out docs --exclude '**/index.ts' src",
    "lint": "eslint .",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "express",
    "api",
    "rest",
    "hypermedia",
    "routing",
    "accept",
    "content-type"
  ],
  "author": "Meraki Solutions <team@meraki.inc> (https://meraki.inc)",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.0",
    "@types/supertest": "^6.0.2",
    "c8": "^10.1.0",
    "eslint": "^9.0.0",
    "express": "^5.1.0",
    "mocha": "^10.8.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.27.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "connect-timeout": "^1.9.1"
  },
  "peerDependencies": {
    "@types/node": ">=16",
    "express": "^4.0.0 || ^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "overrides": {
    "serialize-javascript": "^7.1.2"
  },
  "bugs": {
    "url": "https://github.com/ajwasi/express-router-adapter/issues"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  }
}
